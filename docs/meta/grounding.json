      "id": "C1",
      "paper_ref": "Theorem 1 (Error Contraction)",
      "claim": "For Metzler generators, L1 error is non-increasing under the semigroup: ||e^{Qt}(p - p̃)||₁ ≤ ||p - p̃||₁",
      "proof": "docs/paper/tool_paper.tex, Appendix A (app:proofs)",
      "code": "src/tn_check/error/propagation.py::propagate_error()",
      "test": "tests/test_error.py::test_l1_contraction_metzler",
      "numerical_verification": "src/tn_check/evaluation/math_rigor.py::verify_contraction()"
    },
    {
      "id": "C2",
      "paper_ref": "Theorem 2 (Bond Preservation for Axis-Aligned Predicates)",
      "claim": "Axis-aligned predicates preserve bond dimension: χ(1_Φ ⊙ p) ≤ χ(p)",
      "proof": "docs/paper/tool_paper.tex, Section 4",
      "code": "src/tn_check/checker/satisfaction.py::compute_satisfaction_set()",
      "test": "tests/test_checker.py::test_bond_preservation",
